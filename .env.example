# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El ".env" real NUNCA se sube a git (ver .gitignore).

# --- Django ---
# Genera una clave larga y aleatoria, distinta para cada entorno (dev/producción).
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# En tu máquina de desarrollo: True. En el servidor real: False (o directamente no la pongas).
DEBUG=True

# Dominios/IPs desde los que se puede acceder, separados por coma. Ej: midominio.gob.bo,192.168.1.10
# En desarrollo local basta con: 127.0.0.1,localhost
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (PostgreSQL) ---
DB_NAME=gestion_procesos
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Correo y aviso de errores (opcional) ---
# Si dejas ADMIN_EMAIL vacío, el sistema funciona igual, solo que no te avisa
# por correo cuando ocurre un error 500 en producción (sí queda igual en logs/django.log).
ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
